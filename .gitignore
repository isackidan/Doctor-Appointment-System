# IDE and Editor directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# AI Assistant configs & cache
.claude/
backend/.claude/
.windsurf/
backend/.windsurf/
skills-lock.json
backend/skills-lock.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

