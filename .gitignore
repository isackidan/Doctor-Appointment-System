# Dependencies
node_modules/
*/node_modules/

# Environment Variables (Keep secrets safe!)
.env
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
backend/.env
frontend/.env
!*.env.example

# Production Builds
dist/
dist-ssr/
frontend/dist/
build/

# Uploaded User Files & Media (Keep directory structure with .gitkeep)
backend/uploads/*
